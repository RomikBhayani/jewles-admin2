<%- include('../layout') %>

<div class="card">
    <div class="card-title">⚙️ System Settings</div>
    
    <div style="margin-bottom: 2rem;">
        <h3>Theme</h3>
        <div class="form-group">
            <label class="form-label">Theme Color (Primary)</label>
            <input type="color" id="primaryColor" class="form-input" value="#2563eb">
        </div>
        <button class="btn btn-primary" onclick="saveTheme()">Save Theme</button>
    </div>

    <div style="border-top: 1px solid var(--color-border); padding-top: 2rem;">
        <h3>Pricing Configuration</h3>
        <div class="form-group">
            <label class="form-label">Default Making Charge (%)</label>
            <input type="number" id="makingCharge" class="form-input" step="0.01" value="5">
        </div>
        <div class="form-group">
            <label class="form-label">Default Tax Rate (%)</label>
            <input type="number" id="taxRate" class="form-input" step="0.01" value="18">
        </div>
        <button class="btn btn-primary" onclick="savePricing()">Save Pricing Settings</button>
    </div>
</div>

<script>
    function saveTheme() {
        const primaryColor = document.getElementById('primaryColor').value;
        localStorage.setItem('primaryColor', primaryColor);
        document.documentElement.style.setProperty('--color-primary', primaryColor);
        alert('Theme saved!');
    }

    function savePricing() {
        const makingCharge = document.getElementById('makingCharge').value;
        const taxRate = document.getElementById('taxRate').value;
        localStorage.setItem('makingCharge', makingCharge);
        localStorage.setItem('taxRate', taxRate);
        alert('Pricing settings saved!');
    }

    document.addEventListener('DOMContentLoaded', () => {
        const primaryColor = localStorage.getItem('primaryColor');
        if (primaryColor) {
            document.getElementById('primaryColor').value = primaryColor;
            document.documentElement.style.setProperty('--color-primary', primaryColor);
        }
    });
</script>
